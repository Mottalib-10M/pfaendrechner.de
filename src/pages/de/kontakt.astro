---
import PageLayout from '../../layouts/PageLayout.astro';
import { CONTACT_EMAIL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'de';
const description = 'Schreiben Sie uns, wenn ein Betrag, eine Tabelle oder eine Frist nicht stimmt, oder wenn Sie den Pfändungsrechner auf Ihrer eigenen Seite einbinden möchten.';
---
<PageLayout title={`Kontakt zu ${SITE_NAMES[lang]}: Fehler melden, Rechner einbinden`} description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Kontakt', description, path: route('contact', lang), lang })]} breadcrumbs={[{ label: 'Kontakt' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Kontakt</h1>
    <p>E-Mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Antwort meist innerhalb einer Woche.</p>
    <h2>Ein Betrag oder eine Frist scheint falsch</h2>
    <p>Nennen Sie die Seite, Ihre Eingaben und, wenn möglich, die Zeile der amtlichen Tabelle oder den Paragrafen. Wir prüfen an der Quelle und korrigieren innerhalb weniger Tage. Schicken Sie uns bitte keinen Pfändungsbeschluss, keine Kontoauszüge und keine Namen: Die Zahlen genügen.</p>
    <h2>Rechner einbinden</h2>
    <p>Vereine, Sozialdienste und Ratgeberseiten können den Pfändungsrechner und den P-Konto-Rechner kostenlos einbinden: <a href={route('widget', lang)}>Rechner einbinden</a>.</p>
    <h2>Was wir nicht leisten</h2>
    <p>Keine Rechtsberatung im Einzelfall, keine Prüfung Ihres Beschlusses, keine Verhandlung mit Gläubigern und keine Vermittlung an Dritte. Diese Seite rechnet nach Gesetz und Tabelle, mehr nicht.</p>
  </div>
</PageLayout>
