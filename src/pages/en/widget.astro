---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'pfaendungsrechner', h2: 'Garnishment calculator', text: 'Enter net pay, dependants and pay period: the calculator shows the attachable and the protected amount under the current table.', t: 'German wage garnishment calculator', h: 900 },
  { name: 'p-konto', h2: 'P-account calculator', text: 'Shows how much is protected on a German P-account each month, with dependants, child benefit and social benefits.', t: 'German P-account allowance', h: 820 },
];
---
<PageLayout title="Embed the German garnishment calculator and P-account tool" description="Embed the German wage garnishment calculator and the P-account tool for free with an iframe: copy the code once, each new yearly table appears automatically." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the garnishment calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For charities, social services, associations and advice sites: copy once, and each new garnishment table appears automatically.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>For the German version, replace <code>/embed/en/</code> with <code>/embed/de/</code>. Terms: the source link below the calculator stays visible, the calculator is not altered and is provided without warranty. What your readers enter stays on their device. Questions via the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/pfaendungsrechner/`} title="German wage garnishment calculator" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
