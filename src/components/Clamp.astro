---
/**
 * Chapeau replié (RECETTE §26) : UN seul <p> dans le HTML, entier ; l'écran montre les premières
 * phrases, la suite est dans un <span> masqué du même <p>, dépliée par une case à cocher, sans
 * JavaScript. check-seo trouve ainsi le bloc de 120 mots dans les 30 premiers % de la page (§21).
 */
import { t } from '../i18n/ui';
import type { Locale } from '../i18n/routes';
interface Props { text: string; lang: Locale; id: string; sentences?: number; class?: string }
const { text, lang, id, sentences = 1, class: cls = '' } = Astro.props;
// Coupe entre deux phrases : ponctuation finale, espace, puis majuscule. « 7,5 % » ne coupe pas.
// Pas de coupure après un nombre ordinal (« 1. Juli ») ni une abréviation courante (« z. B. », « Abs. », « Nr. »).
const parts = text.split(/(?<!\b\d{1,2}\.)(?<!\b(?:Abs|Nr|Art|bzw|ca|vgl|z\. B|S|No|Sec)\.)(?<=[.!?])\s+(?=\p{Lu})/u);
const head = parts.slice(0, sentences).join(' ').trim();
const rest = parts.slice(sentences).join(' ').trim();
---
<div class={`clamp ${cls}`}>
  {rest && <input type="checkbox" id={id} class="clamp-toggle" />}
  <p class="text-navy-800">{head}{rest && <span class="clamp-rest"> {rest}</span>}</p>
  {rest && <label for={id} class="clamp-more">{t(lang).readMore}</label>}
</div>
